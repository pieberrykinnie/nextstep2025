{
  "manifest_version": 3,
  "name": "LimitlessMeet",
  "description": "Inclusive meeting co-pilot: offline captions, summaries, action items, shortcuts.",
  "version": "0.0.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "../dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LimitlessMeet"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["../dist/inject.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "../assets/icons/icon128.png"
  }
}